flowchart LR
    subgraph Input ["Eingabe"]
        Binary[("Binärdatei")]
    end

    subgraph AngrCore ["angr Framework"]
        Project["<b>Project</b><br/>Lädt Binary, CFG, Architecture"]
        KB[("<b>Knowledge Base</b><br/>SimProcedures (printf, malloc...)")]
        
        subgraph StateEngine ["Zustands-Engine"]
            SimState["<b>SimState</b><br/>Registers, Memory, Path Constraints"]
            Claripy["<b>Claripy</b><br/>ASTs, Symbolic Logic"]
            Solver[("SMT Solver (Z3)<br/>Concrete Values")]
        end

        SimMgr["<b>SimulationManager</b><br/>Stashes: active, found, deadended"]
    end

    subgraph Output ["Ausgabe"]
        Solution["Konkreter Input<br/>(Proof of Concept)"]
    end

    Binary --> Project
    Project --> KB
    Project --> SimState
    KB -.->|Hooks| SimState
    SimState <-->|Constraints / ASTs| Claripy
    Claripy <-->|Query / Solve| Solver
    SimState --> SimMgr
    SimMgr -->|Clone / Step| SimState
    SimMgr -->|Found State| Solution

